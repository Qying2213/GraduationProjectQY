# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=qinyang
DB_PASSWORD=
DB_NAME=talent_platform

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置
JWT_SECRET=your_jwt_secret_key

# Coze AI配置 (字节跳动)
# 只需要3个配置项即可连接Coze
COZE_BASE_URL=https://api.coze.cn
COZE_TOKEN=your_coze_api_token
COZE_WORKFLOW_ID=your_workflow_id

# 火山引擎豆包Embedding配置
# 只需要3个配置项
VOLC_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
VOLC_API_KEY=your_volcengine_api_key
VOLC_MODEL_ID=doubao-embedding-large-text-240915

# Elasticsearch配置 (可选)
ES_URL=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
