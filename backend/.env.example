# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=talent_platform

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置
JWT_SECRET=your_jwt_secret_key

# Coze AI配置 (字节跳动)
COZE_BASE_URL=https://api.coze.cn
COZE_API_TOKEN=your_coze_api_token
COZE_RESUME_WORKFLOW_ID=your_resume_parse_workflow_id
COZE_ATTRIBUTION_WORKFLOW_ID=your_attribution_workflow_id

# 火山引擎豆包Embedding配置
VOLC_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
VOLC_ACCESS_KEY=your_volcengine_access_key
VOLC_SECRET_KEY=your_volcengine_secret_key
VOLC_EMBEDDING_MODEL=doubao-embedding

# Elasticsearch配置 (可选)
ES_URL=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
